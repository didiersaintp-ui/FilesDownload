# Global Configuration Example
# Copy this file to .env and fill in your values

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus

# Storage Account (must be globally unique, 3-24 lowercase alphanumeric)
AZURE_STORAGE_ACCOUNT_NAME=stdevicemanifestpoc001

# AKS Configuration
AKS_CLUSTER_NAME=aks-devicemanifest
AKS_RESOURCE_GROUP=rg-devicemanifest-aks
AKS_NODE_COUNT=3
AKS_VM_SIZE=Standard_D4s_v3

# Azure Container Registry
ACR_NAME=myacr

# MinIO Configuration (for local testing)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=device-files

# Device Simulator
SIMULATOR_API_URL=http://localhost:5000
SIMULATOR_DEVICE_COUNT=100
SIMULATOR_PARALLELISM=10
SIMULATOR_DOWNLOAD_FILES=false
